PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sp3digital_identity
DB_USER=identity_service
DB_PASSWORD=replace_me

# Configure exactly one verifier. ADMIN_JWKS_URL is recommended for production.
ADMIN_JWKS_URL=https://idp.example.com/.well-known/jwks.json
ADMIN_JWT_ISSUER=https://idp.example.com/
ADMIN_JWT_AUDIENCE=sp3-identity-admin
# ADMIN_JWT_SECRET=development_only_shared_secret

# MFA secret-at-rest encryption (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=replace_with_base64_32_byte_key
MFA_ENCRYPTION_KEY_VERSION=v1
# Keep old keys around under MFA_ENCRYPTION_KEY_<version> (e.g. MFA_ENCRYPTION_KEY_v1)
# so secrets written under a previous version still decrypt until they're
# rotated onto the current key via POST /users/:userId/mfa/:mfaId/rotate.

# MFA TOTP verification lockout (brute-force protection)
MFA_TOTP_ISSUER=SP3 Digital
MFA_MAX_FAILED_ATTEMPTS=5
MFA_LOCKOUT_MINUTES=15

# Password hashing cost (bcrypt). 12 is a reasonable default; raise as hardware allows.
PASSWORD_BCRYPT_COST=12

# --- Token issuance (/api/v1/identity-admin/auth/login etc.) ---
# RS256 key pair this service uses to SIGN tokens it issues. Generate with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log(privateKey.export({type:'pkcs1',format:'pem'}));console.log(publicKey.export({type:'pkcs1',format:'pem'}))"
# Either paste the PEM inline (with \n for newlines) or point to a mounted file via the _PATH variant.
JWT_PRIVATE_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=
JWT_KEY_ID=v1
JWT_ISSUER=https://idp.example.com/
# If this service is acting as its own IdP, point ADMIN_JWKS_URL (above) at
# this same service's /.well-known/jwks.json so authentication.js can verify
# the tokens /auth/login issues.

ACCESS_TOKEN_TTL_SECONDS=900
ID_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# HS256 secret used only to sign the short-lived MFA challenge token between
# POST /auth/login and POST /auth/login/mfa. Falls back to JWT_PRIVATE_KEY if unset.
MFA_CHALLENGE_SECRET=replace_with_random_secret
MFA_CHALLENGE_TTL_SECONDS=300


