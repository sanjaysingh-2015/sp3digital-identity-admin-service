+  tenantUuid: Joi.string().uuid().required(),
+  // Required unless forceChange=true — see the .when() below.
+  oldPassword: Joi.string().min(1).max(256).when('forceChange', { is: true, then: Joi.optional(), otherwise: Joi.required() }),
